<UserControl x:Class="Ofcas.Lk.Api.Client.Demo.Controls.TextInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utils="clr-namespace:Ofcas.Lk.Api.Client.Demo.Utils"
             xmlns:controls="clr-namespace:Ofcas.Lk.Api.Client.Demo.Controls"
             x:Name="TextInputControl">
    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="Default" DataType="controls:TextInput">
                <TextBox Text="{Binding Text, ElementName=TextInputControl, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>

            <DataTemplate x:Key="WithEntries" DataType="controls:TextInput">
                <ComboBox IsEditable="True"
                          ItemsSource="{Binding Entries, ElementName=TextInputControl, UpdateSourceTrigger=PropertyChanged}"
                          Text="{Binding Text, ElementName=TextInputControl, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>

            <utils:TextInputTemplateSelector x:Key="TextInputTemplateSelector"
                                             Default="{StaticResource Default}"
                                             WithEntries="{StaticResource WithEntries}" />
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="PropertyColumn" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Margin="2" VerticalAlignment="Center"
                   Text="{Binding Header, StringFormat='{}{0} ', ElementName=TextInputControl, UpdateSourceTrigger=PropertyChanged}" />

        <ContentControl Grid.Column="2" Margin="2"
                        Focusable="False"
                        Content="{Binding Path=Entries, ElementName=TextInputControl}"
                        ContentTemplateSelector="{StaticResource TextInputTemplateSelector}" />
    </Grid>
</UserControl>