<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.ElementPricelistContainerWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                  xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
                  xmlns:utils="clr-namespace:Ofcas.Lk.Api.Client.Demo.Utils"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance viewModels:ElementPricelistContainerViewModel}"
                  WindowStartupLocation="CenterScreen"
                  Height="400"
                  Width="370"
                  Title="Element Pricelist Container">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_View">
                <MenuItem Header="_CoreObjectDetails" Command="{Binding ShowCoreObjectDetailsCommand}" />
            </MenuItem>
        </Menu>
        
        <Grid Margin="5">
            <Grid>
                <ListView SelectionMode="Single"
                          ItemsSource="{Binding ElementPricelists.ItemsSource}"
                          SelectedItem="{Binding ElementPricelists.SelectedItem}"
                          ToolTip="double-click to open">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150" />
                            <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" Width="150" />
                        </GridView>
                    </ListView.View>

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding OpenChildCommand}"
                                                   CommandParameter="{Binding ElementPricelists.SelectedItem}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ListView>
            </Grid>
        </Grid>
    </DockPanel>
</views:BaseWindow>