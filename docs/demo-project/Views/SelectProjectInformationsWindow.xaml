<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.SelectProjectInformationsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
                  xmlns:utils="clr-namespace:Ofcas.Lk.Api.Client.Demo.Utils"
                  xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance viewModels:SelectProjectInformationsViewModel}"
                  utils:DialogCloser.DialogResult="{Binding DialogResult.Value}"
                  WindowStartupLocation="CenterScreen"
                  Title="Select Project Informations"
                  Height="450"
                  Width="370">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <ListView ItemsSource="{Binding ProjectInformations.ItemsSource}"
                  SelectionMode="Extended"
                  SelectedItem="{Binding ProjectInformations.SelectedItem}"
                  utils:MultiSelectorBehaviours.SynchronizedSelectedItems="{Binding ProjectInformations.SelectedItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding AcceptCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="40" />
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" />
                </GridView>
            </ListView.View>

            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <Expander Header="{Binding Name}" IsExpanded="True"
                                                  d:DataContext="{x:Type GroupItem}">
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <Grid Grid.Row="1" Margin="5">
            <Button Width="100"
                    HorizontalAlignment="Right"
                    Command="{Binding AcceptCommand}"
                    Content="OK"
                    IsDefault="True" />
        </Grid>
    </Grid>
</views:BaseWindow>
