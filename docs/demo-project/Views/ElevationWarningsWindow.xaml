<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.ElevationWarningsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
                  xmlns:utils="clr-namespace:Ofcas.Lk.Api.Client.Demo.Utils"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance viewModels:ElevationWarningsViewModel}"
                  WindowStartupLocation="CenterScreen"
                  Title="Elevation Warnings"
                  Height="200"
                  Width="400">
    <DockPanel>
        <Grid Margin="5">
            <ListView ItemsSource="{Binding ElevationWarnings}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Message" DisplayMemberBinding="{Binding Message}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</views:BaseWindow>
