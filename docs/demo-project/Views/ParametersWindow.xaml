<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.ParametersWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:utils="clr-namespace:Ofcas.Lk.Api.Client.Demo.Utils"
                  xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
                  xmlns:interfaces="clr-namespace:Ofcas.Lk.Api.Client.Demo.Models.Interfaces"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  d:DataContext="{d:DesignInstance viewModels:ParametersViewModel}"
                  Title="{Binding Title}"
                  ResizeMode="NoResize"
                  SizeToContent="WidthAndHeight"
                  WindowStartupLocation="CenterOwner"
                  utils:DialogCloser.DialogResult="{Binding DialogResult.Value}"
                  mc:Ignorable="d">
    <Window.Resources>
        <utils:BindingProxy x:Key="ViewModelBinding" Data="{Binding}" />
        <utils:ParameterObjectToStringConverter x:Key="ParameterObjectToStringConverter" />
    </Window.Resources>
    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="Default" DataType="interfaces:IParameter">
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" />
            </DataTemplate>
            <DataTemplate x:Key="WithRestrictedValues" DataType="interfaces:IParameter">
                <ComboBox SelectedItem="{Binding Value}"
                          ItemsSource="{Binding RestrictedValues}" />
            </DataTemplate>
            <DataTemplate x:Key="AsBoolean" DataType="interfaces:IParameter">
                <CheckBox IsChecked="{Binding Value}" VerticalAlignment="Center" />
            </DataTemplate>
            <DataTemplate x:Key="AsWithHelper" DataType="interfaces:IParameter">
                <Button Content="{Binding Value, Converter={StaticResource ParameterObjectToStringConverter}}" VerticalAlignment="Center" Command="{Binding Data.OpenParameterInputHelperCommand, Source={StaticResource ViewModelBinding}}"
                        CommandParameter="{Binding}"/>
                
            </DataTemplate>

            <utils:ParameterTemplateSelector x:Key="ParameterTemplateSelector"
                                             Default="{StaticResource Default}"
                                             WithRestrictedValues="{StaticResource WithRestrictedValues}"
                                             AsBoolean="{StaticResource AsBoolean}"
                                             AsWithHelper="{StaticResource AsWithHelper}"/>

            <DataTemplate x:Key="ParameterTemplate" DataType="interfaces:IParameter">
                <DataTemplate.Resources>
                    <utils:InvertBooleanConverter x:Key="InvertBoolean" />
                </DataTemplate.Resources>
                <Grid Margin="0,3,0,3" Height="25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="5" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             IsEnabled="{Binding IsRequired, Converter={StaticResource InvertBoolean}}" />

                    <ContentControl Grid.Column="2"
                                    Focusable="False"
                                    Content="{Binding}"
                                    ContentTemplateSelector="{StaticResource ParameterTemplateSelector}" />

                    <Button Grid.Column="4"
                            Content="-"
                            Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid Margin="3">
            <Grid.RowDefinitions>
                <RowDefinition MaxHeight="400" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Width="575"
                  Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock Text="KEY"
                           Grid.Row="0"
                           Grid.Column="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <TextBlock Text="VALUE"
                           Grid.Row="0"
                           Grid.Column="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <ScrollViewer Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="4"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Visible">
                    <ItemsControl ItemsSource="{Binding Parameters}"
                                  ItemTemplate="{StaticResource ParameterTemplate}"
                                  Focusable="False" />
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="1" Margin="5">
                <Button Width="40" HorizontalAlignment="Left" Command="{Binding AddParameterCommand}" Content="+" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="80" Margin="0,0,5,0" Content="OK" IsDefault="True" Command="{Binding AcceptCommand}" />
                    <Button Width="80" Content="Cancel" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</views:BaseWindow>
