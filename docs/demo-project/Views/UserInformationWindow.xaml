<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.UserInformationWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
                  xmlns:utils="clr-namespace:Ofcas.Lk.Api.Client.Demo.Utils"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  xmlns:controls="clr-namespace:Ofcas.Lk.Api.Client.Demo.Controls"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance viewModels:UserInformationViewModel}"
                  WindowStartupLocation="CenterScreen"
                  Title="User Information"
                  Height="150"
                  Width="350">
    <DockPanel>
        <Grid IsSharedSizeScope="True">
            <StackPanel>
                <controls:TextField Header="Name" Text="{Binding UserInformation.Name}" />
                <controls:TextField Header="FullName" Text="{Binding UserInformation.FullName}" />
                <controls:TextField Header="CompanyName" Text="{Binding UserInformation.CompanyName}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</views:BaseWindow>
