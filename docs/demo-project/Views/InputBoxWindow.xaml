<Window x:Class="Ofcas.Lk.Api.Client.Demo.Views.InputBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:utils="clr-namespace:Ofcas.Lk.Api.Client.Demo.Utils"
        Title="{Binding Title.Value}"
        utils:DialogCloser.DialogResult="{Binding DialogResult.Value}"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox Height="23" Width="260" Margin="5" Text="{Binding Value.Value, UpdateSourceTrigger=PropertyChanged}" 
                 utils:KeyboardFocusManager.FocusOnStartup="True" VerticalContentAlignment="Center" />

        <StackPanel Height="35" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Margin="5" IsDefault="True" Command="{Binding AcceptCommand}" />
            <Button Content="Cancel" Width="80" Margin="5" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>