<Window x:Class="Ofcas.Lk.Api.Client.Demo.Views.SelectElevationEditModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
        xmlns:utils="clr-namespace:Ofcas.Lk.Api.Client.Demo.Utils"
        Title="Select Elevation Edit Mode"
        d:DataContext="{d:DesignInstance viewModels:SelectElevationEditModeViewModel}"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">
    <Grid>
        <Grid Height="25"
              Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Content="Edit Mode:" />

            <ComboBox Grid.Column="2"
                      utils:KeyboardFocusManager.FocusOnStartup="True"
                      ItemsSource="{Binding ElevationEditModes}"
                      SelectedItem="{Binding ElevationEditMode.Value, 
                                             UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="Name" />
            <Button Grid.Column="4"
                    Click="OnClickDefault"
                    Content="OK"
                    IsDefault="True" />
        </Grid>
    </Grid>
</Window>