<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.ElevationHistoryWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                  xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:ElevationHistoryViewModel}"
                  WindowStartupLocation="CenterScreen"
                  Title="ElevationHistory"
                  Height="300"
                  Width="900"
                  MinHeight="200"
                  MinWidth="600">
    <DockPanel LastChildFill="True">
        <ListView
                  Margin="2,2,2,2"
                  ItemsSource="{Binding History.ItemsSource}"
                  SelectedItem="{Binding History.SelectedItem}"
                  ToolTip="double-click to edit the comment">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="LastChangedDate" DisplayMemberBinding="{Binding LastChangedDateTime, StringFormat='{}{0:dddd, dd MMMM yyyy HH:mm:ss}'}" />
                    <GridViewColumn Header="Comment" DisplayMemberBinding="{Binding Comment}" />
                    <GridViewColumn Header="Changed By User" DisplayMemberBinding="{Binding ChangedByUser}" />
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding ProcessingStatus.Name}" />
                    <GridViewColumn Header="Amount" DisplayMemberBinding="{Binding Amount}" />
                    <GridViewColumn Header="System Description" DisplayMemberBinding="{Binding SystemDescription}" />
                </GridView>
            </ListView.View>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding EditElevationCommentCommand}"
                                               CommandParameter="{Binding History.SelectedItem}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ListView>
    </DockPanel>
</views:BaseWindow>
