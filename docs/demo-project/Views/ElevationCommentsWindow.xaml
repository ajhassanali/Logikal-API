<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.ElevationCommentsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  xmlns:utils="clr-namespace:Ofcas.Lk.Api.Client.Demo.Utils"
                  xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
                  mc:Ignorable="d"
                  Title="{Binding ElevationName, StringFormat='{}{0} - Comments'}"
                  WindowStartupLocation="CenterScreen"
                  Height="500"
                  Width="600"
                  d:DataContext="{d:DesignInstance viewModels:ElevationCommentsViewModel}">

    <DockPanel>
        <ListView Name="ElevationCommentsListView"
                  Margin="5"
                  ItemsSource="{Binding Comments.ItemsSource}"
                  SelectedItem="{Binding Comments.SelectedItem}">
            <ListView.Resources>
                <utils:StreamToStringConverter x:Key="StreamToStringConverter" />
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} - {1}">
                                    <Binding Path="Type.Id" />
                                    <Binding Path="Type.Name" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding RtfContent, Converter={StaticResource StreamToStringConverter}}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</views:BaseWindow>
