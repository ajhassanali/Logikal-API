<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.ProjectSearchWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
                  xmlns:utils="clr-namespace:Ofcas.Lk.Api.Client.Demo.Utils"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  xmlns:controls="clr-namespace:Ofcas.Lk.Api.Client.Demo.Controls"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance viewModels:ProjectSearchViewModel}"
                  WindowStartupLocation="CenterScreen"
                  Title="Project Search"
                  Height="150"
                  Width="350">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Synchronization">
                <MenuItem Header="_Container" Command="{Binding OpenSynchronizationContainerCommand}" />
            </MenuItem>
        </Menu>
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox Height="23" Width="320" Margin="5" Text="{Binding Query}" 
                     utils:KeyboardFocusManager.FocusOnStartup="True" VerticalContentAlignment="Center" />

            <StackPanel Height="35" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Search" Width="100" Margin="5" Command="{Binding BeginSearchCommand}" />
            </StackPanel>
          <Separator Grid.Row="2" Height="1" />
        </Grid>
    </DockPanel>
</views:BaseWindow>