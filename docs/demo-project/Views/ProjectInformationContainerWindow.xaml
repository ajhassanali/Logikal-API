<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.ProjectInformationContainerWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
                  xmlns:controls="clr-namespace:Ofcas.Lk.Api.Client.Demo.Controls"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  mc:Ignorable="d"
                  Title="{Binding ProjectInformationContainerModel.Name, StringFormat='{}ProjectInformation'}"
                  WindowStartupLocation="CenterScreen"
                  Height="519.718"
                  Width="600"
                  d:DataContext="{d:DesignInstance viewModels:ProjectInformationContainerViewModel}">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Edit">
                <MenuItem Header="Show _Modal" Command="{Binding ShowModalCommand}" />
                <MenuItem Header="Calculate" Command="{Binding CalculateCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_CoreObjectDetails" Command="{Binding ShowCoreObjectDetailsCommand}" />
            </MenuItem>
        </Menu>
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="120" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" IsSharedSizeScope="True">
                <StackPanel>
                    <controls:TextField Header="CoreObjectId"
                                        Text="{Binding ProjectInformationContainerModel.CoreObjectId, StringFormat='{}{0:D}'}" />
                    <controls:TextField Header="Guid"
                                        Text="{Binding ProjectInformationContainerModel.Guid, StringFormat='{}{0:D}'}" />
                    <controls:TextField Header="Id"
                                        Text="{Binding ProjectInformationContainerModel.Type.Id, StringFormat='{}{0:D}'}" />
                    <controls:TextField Header="Name"
                                        Text="{Binding ProjectInformationContainerModel.Type.Name, StringFormat='{}{0:D}'}" />
                    <controls:TextField Header="Calculation required"
                                        Text="{Binding ProjectInformationContainerModel.CalculationRequired, StringFormat='{}{0:D}'}" />
                </StackPanel>
            </Grid>

            <TreeView Name="ProjectInformationsGroupView"
                      Margin="5,0,5,5"
                      ItemsSource="{Binding ProjectInformations.ItemsSource}"
                      Grid.Row="1">
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Id}" />
                            <ItemsControl Margin="10, 0, 0, 0" 
                                          ItemsSource="{Binding Settings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Key}" />
                                            <TextBlock Text=": " />
                                            <TextBlock Text="{Binding Value}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="copy everything"
                                  Command="{Binding CopyProjectInformationCommand}" />
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>
        </Grid>
    </DockPanel>
</views:BaseWindow>
