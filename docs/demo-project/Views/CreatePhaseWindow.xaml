<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.CreatePhaseWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:CreatePhaseViewModel}"
                  FocusManager.FocusedElement="{Binding ElementName=Name}" WindowStartupLocation="CenterScreen"
                  Title="CreatePhaseWindow" Height="300" Width="300" SizeToContent="Height">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="5" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" />
        <TextBox x:Name="tbName" Grid.Row="0" Grid.Column="2" Text="{Binding Name.Value, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="Description:" Grid.Row="2" Grid.Column="0" />
        <TextBox x:Name="Description" Grid.Row="2" Grid.Column="2" Text="{Binding Description.Value, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" 
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="75" IsDefault="True" Click="OkayOnClick" />
        </StackPanel>
    </Grid>
</views:BaseWindow>