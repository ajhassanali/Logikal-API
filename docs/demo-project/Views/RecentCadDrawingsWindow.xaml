<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.RecentCadDrawingsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                  xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:RecentProjectsViewModel}"
                  WindowStartupLocation="CenterScreen"
                  Title="RecentCadDrawingsWindow"
                  Height="200"
                  Width="600">
    <StackPanel>
        <ListView Name="RecentCadDrawingsList"
                  Margin="2,2,2,2"
                  MinWidth="400"
                  MinHeight="200"
                  ItemsSource="{Binding CadDrawings}">
            <ListView.View>
                <GridView>
                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="LastChangedDate" DisplayMemberBinding="{Binding LastChangedDate, StringFormat='{}{0:dddd, dd MMMM yyyy HH:mm:ss}'}" />
                        <GridViewColumn Header="Path" DisplayMemberBinding="{Binding Path}" />
                    </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</views:BaseWindow>