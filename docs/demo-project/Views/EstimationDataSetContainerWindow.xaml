<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.EstimationDataSetContainerWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
                  xmlns:utils="clr-namespace:Ofcas.Lk.Api.Client.Demo.Utils"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance viewModels:EstimationDataSetContainerViewModel}"
                  WindowStartupLocation="CenterScreen"
                  utils:DialogCloser.DialogResult="{Binding DialogResult.Value}"
                  Height="400"
                  Width="370"
                  Title="Estimation Data Set Container">

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_View">
                <MenuItem Header="_CoreObjectDetails" Command="{Binding ShowCoreObjectDetailsCommand}" />
            </MenuItem>
        </Menu>

        <Grid Margin="5">
            <Grid>
                <ListView SelectionMode="Single"
                          ItemsSource="{Binding EstimationDataSets.ItemsSource}"
                          SelectedItem="{Binding EstimationDataSets.SelectedItem}"
                          ToolTip="double-click to open">

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding AcceptCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Id" DisplayMemberBinding="{Binding Id}" Width="100" />
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="100" />
                            <GridViewColumn Header="Protected" DisplayMemberBinding="{Binding IsProtected}" Width="40" />
                            <GridViewColumn Header="Default" DisplayMemberBinding="{Binding IsDefault}" Width="40" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
    </DockPanel>
</views:BaseWindow>
