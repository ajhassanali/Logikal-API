<views:BaseWindow x:Class="Ofcas.Lk.Api.Client.Demo.Views.DocumentContainerWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:core="clr-namespace:Ofcas.Lk.Api.Client.Core;assembly=Ofcas.Lk.Api.Client.Core"
                  xmlns:viewModels="clr-namespace:Ofcas.Lk.Api.Client.Demo.ViewModels"
                  xmlns:views="clr-namespace:Ofcas.Lk.Api.Client.Demo.Views"
                  xmlns:utils="clr-namespace:Ofcas.Lk.Api.Client.Demo.Utils"
                  mc:Ignorable="d"
                  d:DataContext="{d:DesignInstance viewModels:DocumentContainerViewModel}"
                  Title="{Binding ParentName, StringFormat={}DocumentContainer [{0}]}"
                  Width="365"
                Height="450.0"
                WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_View">
                <MenuItem Header="_CoreObjectDetails"
                          Command="{Binding ShowCoreObjectDetailsCommand}" />
            </MenuItem>
            <MenuItem Header="_Synchronization">
                <MenuItem Header="_Refresh"
                          Command="{Binding ForceRefreshCommand}" />
                <Separator />
                <MenuItem Header="_Container"
                          Command="{Binding OpenSynchronizationContainerCommand}" />
            </MenuItem>
        </Menu>

        <ListView x:Name="ListView"
                  MinWidth="240"
                  Margin="5"
                  ItemsSource="{Binding Documents.ItemsSource}"
                  SelectedItem="{Binding Documents.SelectedItem}"
                  utils:MultiSelectorBehaviours.SynchronizedSelectedItems="{Binding Documents.SelectedItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectionMode="Extended"
                  ToolTip="Double-click to open the Document window">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick">
                    <i:InvokeCommandAction Command="{Binding OpenDocumentCommand}"
                                           CommandParameter="{Binding SelectedItem,
                                                                      ElementName=ListView}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
            <ListView.ContextMenu>
                <ContextMenu Name="RightClickContextMenu">
                    <MenuItem Header="create"
                              Command="{Binding CreateDocumentCommand}" />

                    <MenuItem Header="create Shortcut"
                              Command="{Binding CreateShortcutCommand}" />

                    <MenuItem Header="delete"
                              Command="{Binding DeleteDocumentCommand}"
                              CommandParameter="{Binding Documents.SelectedItem}" />

                    <Separator />

                    <MenuItem Header="copy"
                              Command="{Binding CopyDocumentCommand}"
                              CommandParameter="{Binding Documents.SelectedItem}" />

                    <MenuItem Header="paste"
                              Command="{Binding PasteDocumentCommand}" />

                    <MenuItem Header="move"
                              Command="{Binding MoveDocumentCommand}" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="FileName">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="core:DocumentInfo">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="core:DocumentInfo">
                                <TextBlock Text="{Binding Type}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</views:BaseWindow>
